      "index": "aH",
      "roundness": null,
      "seed": 1582652281,
      "version": 24,
      "versionNonce": 781977207,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790749167928,
      "link": null,
      "locked": false,
      "text": "Before refreshing, it marks the failed request with\n_retry = true. Then it calls POST /auth/refresh-\ntoken using the same Axios client.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Before refreshing, it marks the failed request with _retry = true. Then it calls POST /auth/refresh-token using the same Axios client.",
      "autoResize": false,
      "lineHeight": 1.25
    },
