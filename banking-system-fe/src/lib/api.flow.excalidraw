      "text": "Before each request, the request interceptor checks\nthe endpoint",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Before each request, the request interceptor checks the endpoint",
