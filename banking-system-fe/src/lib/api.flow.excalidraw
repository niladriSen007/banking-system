    },
    {
      "id": "S4lhz2hTN3plGubQJujT4",
      "type": "text",
      "x": 492,
      "y": 431,
      "width": 622,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 1096606809,
      "version": 56,
      "versionNonce": 1965109817,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790748999176,
      "link": null,
      "locked": false,
      "text": "- It first checks whether the URL ends with \n    -> /auth/login\n    -> /auth/signup\n    -> /auth/refresh-token.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- It first checks whether the URL ends with \n    -> /auth/login\n    -> /auth/signup\n    -> /auth/refresh-token.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "p2rNAZbyc8ERYcC4oHkiZ",
      "type": "text",
      "x": 614,
      "y": 577,
      "width": 610,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 2023599769,
      "version": 88,
      "versionNonce": 1521789849,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790749019895,
      "link": null,
      "locked": false,
      "text": "For those auth endpoints, it skips adding an\nAuthorization header.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For those auth endpoints, it skips adding an Authorization header.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "TD7nqF6P6e5UMOe898HR_",
      "type": "text",
      "x": 610,
      "y": 667.5,
      "width": 718,
      "height": 105,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6",
      "roundness": null,
      "seed": 1481426489,
      "version": 47,
      "versionNonce": 866887063,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790749028736,
      "link": null,
      "locked": false,
      "text": "For other endpoints, it reads the access token from\nthe Zustand auth store. If one exists, it adds\nAuthorization: Bearer <token>.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For other endpoints, it reads the access token from the Zustand auth store. If one exists, it adds Authorization: Bearer <token>.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "1xSkMTvP260DSWAsXGPG6",
      "type": "text",
      "x": 460,
      "y": 820.5,
      "width": 596,
      "height": 35,
      "angle": 0,
