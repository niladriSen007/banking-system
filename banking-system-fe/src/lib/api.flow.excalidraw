      "isDeleted": false,
      "boundElements": [],
      "updated": 1790749154182,
      "link": null,
      "locked": false,
      "text": "The client refreshes the access token",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The client refreshes the access token",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "W0znVFzTbya1_TtcOrnis",
      "type": "text",
      "x": 608,
      "y": 1645.5,
      "width": 690,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
