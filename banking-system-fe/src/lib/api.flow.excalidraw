      "versionNonce": 844275159,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790749145240,
      "link": null,
      "locked": false,
      "text": "Other failures are rejected as-is. For example, a 403\ndoes not trigger a refresh.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Other failures are rejected as-is. For example, a 403 does not trigger a refresh.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "BwhS0gEUphvoQitZ-Lbd5",
      "type": "text",
      "x": 460.5,
      "y": 1584.5,
