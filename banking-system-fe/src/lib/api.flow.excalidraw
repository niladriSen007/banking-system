      "index": "a8",
      "roundness": null,
      "seed": 2137228823,
      "version": 44,
      "versionNonce": 1706639481,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790749062249,
      "link": null,
      "locked": false,
      "text": "The response interceptor’s success handler returns\nthe response unchanged. The API helper functions\nelsewhere in the app then check the response envelope\nand extract its data.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The response interceptor’s success handler returns the response unchanged. The API helper functions elsewhere in the app then check the response envelope and extract its data.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
