      "isDeleted": false,
      "boundElements": [],
      "updated": 1790749197829,
      "link": null,
      "locked": false,
      "text": "The refresh response must have a successful API\nstatus, status code 200, and a non-empty\naccessToken. If valid, the new token is saved in\nZustand.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The refresh response must have a successful API status, status code 200, and a non-empty accessToken. If valid, the new token is saved in Zustand.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "85pcxXCf-IC8xoQE2XGPe",
